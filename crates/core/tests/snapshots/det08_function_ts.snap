---
source: crates/core/tests/detect.rs
---
[function]
build = "bun build src/index.ts --outfile build/index.js --target browser --format esm --external 'wasi:*' && mkdir -p dist && bunx @bytecodealliance/jco componentize build/index.js --wit wit --world-name function --out dist/fn.wasm"
component = "dist/fn.wasm"

[dev]
command = "bun dev"

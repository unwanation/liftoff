==> .gitlab-ci.yml (compose)
# Deploys to liftoff on every push. CI/CD variables from `lof secret sync`:
# LIFTOFF_TOKEN.
deploy:
  image: docker:27
  services: [docker:27-dind]
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  script:
    - echo "$CI_REGISTRY_PASSWORD" | docker login "$CI_REGISTRY" -u "$CI_REGISTRY_USER" --password-stdin
    - docker buildx build --push -t "$CI_REGISTRY_IMAGE:sha-$CI_COMMIT_SHA" .
    - apk add --no-cache curl
    - |
      curl -fsS https://liftoff.example.com/api/v1/deploys \
        -H "Authorization: Bearer $LIFTOFF_TOKEN" \
        -F "repo=$CI_PROJECT_PATH" -F "ref=$CI_COMMIT_REF_NAME" \
        -F "tag=sha-$CI_COMMIT_SHA" -F "compose=@deploy/compose.yaml"

==> .gitlab-ci.yml (function)
# Deploys to liftoff on every push. CI/CD variables from `lof secret sync`:
# LIFTOFF_TOKEN. The job's image needs curl and the toolchain of the build
# command.
deploy:
  script:
    - |
      bun install && bun run build
    - |
      curl -fsS https://liftoff.example.com/api/v1/deploys \
        -H "Authorization: Bearer $LIFTOFF_TOKEN" \
        -F "repo=$CI_PROJECT_PATH" -F "ref=$CI_COMMIT_REF_NAME" \
        -F "component=@dist/fn.wasm"

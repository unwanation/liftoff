---
source: crates/proxy/tests/json.rs
---
{
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ]
            }
          ]
        },
        "https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "headers",
                  "request": {
                    "delete": [
                      "X-Liftoff-*"
                    ]
                  }
                },
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "match": [
                {
                  "host": [
                    "liftoff.test"
                  ],
                  "path": [
                    "/internal",
                    "/internal/*"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "request": {
                    "delete": [
                      "X-Liftoff-*"
                    ]
                  }
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:7000"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "liftoff.test"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "request": {
                    "delete": [
                      "X-Liftoff-*"
                    ]
                  }
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20000"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.apps.test"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "request": {
                    "delete": [
                      "X-Liftoff-*"
                    ]
                  }
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20001"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.example.org"
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "on_demand": {
          "permission": {
            "endpoint": "http://127.0.0.1:7000/internal/tls-ask",
            "module": "http"
          }
        },
        "policies": [
          {
            "issuers": [
              {
                "email": "ops@example.com",
                "module": "acme"
              }
            ],
            "on_demand": true,
            "subjects": [
              "shop.example.org"
            ]
          },
          {
            "issuers": [
              {
                "email": "ops@example.com",
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  }
}
